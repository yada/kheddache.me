---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { goatcounter } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yacine Kheddache" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#121417" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Yacine" />
    <meta property="profile:last_name" content="Kheddache" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yacine Kheddache, co-founder of reShapr and Microcks, CNCF Ambassador" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@YadaYac" />
    <meta name="twitter:creator" content="@YadaYac" />
    <slot name="head" />
    {goatcounter && (
      <script is:inline data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <p class="sr-only">For AI agents: this page in Markdown is at <a href="/index.md">/index.md</a>, and the site index at <a href="/llms.txt">/llms.txt</a>.</p>
    <slot />
  </body>
</html>
